rules_version = '2';

// GENERATED by `npm run rules` from packages/shared/src/highscore + petitions.
// Do not edit by hand. Public read; create-only highscores; petitions + votes; 1v1 duel matches/ratings.
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(name) {
      return name is string
        && name.size() >= 1 && name.size() <= 16
        && name.matches("[\\p{L}\\p{N}.,!?'_\\-]([\\p{L}\\p{N}.,!?'_\\- ]{0,14}[\\p{L}\\p{N}.,!?'_\\-])?")
        && !name.lower().replace('[^a-z]', '').matches(".*(fuck|shit|cunt|nigg|faggot|whore|bitch|asshole|retard|pussy|rapist|hitler|porn|motherf|wanker|dildo|jizz|kurwa|chuj|pierdol|jeban|pizd).*")
        && !name.lower().matches("(.*[^a-z])?(ass|arse|fag|cock|dick|slut|rape|nazi|kike|spic|chink|coon|gook|tit|twat|wank|penis|vagina|cum|anal|anus|sex|tranny|piss|prick|bollock|dupa|cipa|huj)s?([^a-z].*)?");
    }

    function validRun(runId, d) {
      return runId.matches("[A-Za-z0-9_-]{6,64}")
        && d.teamSize is int && d.teamSize >= 1 && d.teamSize <= 8
        && d.names is list && d.names.size() == d.teamSize
        && (d.names.size() <= 0 || validName(d.names[0]))
        && (d.names.size() <= 1 || validName(d.names[1]))
        && (d.names.size() <= 2 || validName(d.names[2]))
        && (d.names.size() <= 3 || validName(d.names[3]))
        && (d.names.size() <= 4 || validName(d.names[4]))
        && (d.names.size() <= 5 || validName(d.names[5]))
        && (d.names.size() <= 6 || validName(d.names[6]))
        && (d.names.size() <= 7 || validName(d.names[7]))
        && d.survivalMs is int && d.survivalMs >= 1000 && d.survivalMs <= 14400000
        && d.kills is int && d.kills >= 0 && d.kills <= 1000000
        && d.kills * 1000 <= d.survivalMs * 25 * d.teamSize + 50000
        && d.wave is int && d.wave >= 0 && d.wave <= 1000
        && (d.wave <= 1 || (d.wave - 1) * 8000 <= d.survivalMs - 4000)
        && d.mode in ['local', 'p2p', 'dedicated']
        && d.version is string && d.version.matches("\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-[0-9A-Za-z.]{1,12})?")
        && d.timestamp == request.time;
    }

    // v0.4+: per-marine points / kills (personal score = sum of kill points).
    function validMarine(d, i) {
      return d.playerScores[i] is int && d.playerScores[i] >= 0
        && d.playerScores[i] * 1000 <= d.survivalMs * 40 + 500000
        && d.playerKills[i] is int && d.playerKills[i] >= 0 && d.playerKills[i] <= d.kills
        && d.playerKills[i] * 1000 <= d.survivalMs * 25 + 50000;
    }

    function validScores(d) {
      return d.playerScores is list && d.playerScores.size() == d.teamSize
        && d.playerKills is list && d.playerKills.size() == d.teamSize
        && (d.teamSize <= 0 || validMarine(d, 0))
        && (d.teamSize <= 1 || validMarine(d, 1))
        && (d.teamSize <= 2 || validMarine(d, 2))
        && (d.teamSize <= 3 || validMarine(d, 3))
        && (d.teamSize <= 4 || validMarine(d, 4))
        && (d.teamSize <= 5 || validMarine(d, 5))
        && (d.teamSize <= 6 || validMarine(d, 6))
        && (d.teamSize <= 7 || validMarine(d, 7));
    }

    function validBoard(board) {
      return board.matches("[0-9]{1,3}[.][0-9]{1,3}([.][0-9]{1,3})?");
    }

    // major.minor boards (v0.2 .. v0.5.0) take every patch of that minor; full-version boards
    // (v0.5.1+, e.g. boards/0.5.1) only that exact version (a -suffix such as -test allowed).
    function boardVersion(board, d) {
      return d.board == board
        && d.version is string
        && d.version.split('[.]').size() >= 3
        && ((board.matches("[0-9]{1,3}[.][0-9]{1,3}")
            && d.version.split('[.]')[0] + '.' + d.version.split('[.]')[1] == board)
          || (board.matches("[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}")
            && d.version.split('[-+]')[0] == board));
    }

    // An individual score row must mirror its run, written in the same commit.
    function validScoreRow(board, scoreId, d) {
      let run = getAfter(/databases/$(database)/documents/boards/$(board)/highscores/$(d.runId)).data;
      return d.slot is int && d.slot >= 0 && d.slot < 8
        && d.runId is string && scoreId == d.runId + '-' + string(d.slot)
        && d.timestamp == request.time
        && run.timestamp == request.time
        && d.slot < run.teamSize
        && d.teamSize == run.teamSize
        && d.name == run.names[d.slot]
        && d.score == run.playerScores[d.slot]
        && d.kills == run.playerKills[d.slot]
        && d.survivalMs == run.survivalMs
        && d.version == run.version;
    }

    // Legacy v0.1.x board (frozen /v0.1.0/ build): unchanged field set, no board field.
    match /highscores/{runId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp'])
        && request.resource.data.keys().hasAll(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp'])
        && validRun(runId, request.resource.data);
      allow update, delete: if false;
    }

    // Per-version boards (v0.2+): boards/0.4/highscores (major.minor, up to v0.5.0), then one
    // board per release from v0.5.1: boards/0.5.1/highscores.
    // v0.2/v0.3 (frozen builds) keep their field set; v0.4+ runs carry per-marine scores.
    match /boards/{board}/highscores/{runId} {
      allow read: if validBoard(board);
      allow create: if validBoard(board)
        && boardVersion(board, request.resource.data)
        && validRun(runId, request.resource.data)
        && ((board in ['0.2', '0.3']
            && request.resource.data.keys().hasOnly(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp', 'board'])
            && request.resource.data.keys().hasAll(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp', 'board']))
          || (!(board in ['0.2', '0.3'])
            && request.resource.data.keys().hasOnly(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp', 'board', 'playerScores', 'playerKills'])
            && request.resource.data.keys().hasAll(['teamSize', 'names', 'survivalMs', 'kills', 'wave', 'mode', 'version', 'timestamp', 'board', 'playerScores', 'playerKills'])
            && validScores(request.resource.data)));
      allow update, delete: if false;
    }

    // Individual leaderboard (v0.4+): boards/{board}/scores/{runId}-{slot}.
    match /boards/{board}/scores/{scoreId} {
      allow read: if validBoard(board);
      allow create: if validBoard(board)
        && !(board in ['0.2', '0.3'])
        && request.resource.data.keys().hasOnly(['runId', 'slot', 'name', 'score', 'kills', 'teamSize', 'survivalMs', 'version', 'board', 'timestamp'])
        && request.resource.data.keys().hasAll(['runId', 'slot', 'name', 'score', 'kills', 'teamSize', 'survivalMs', 'version', 'board', 'timestamp'])
        && boardVersion(board, request.resource.data)
        && validScoreRow(board, scoreId, request.resource.data);
      allow update, delete: if false;
    }

    // Vox Relay (feedback): top-level petitions + petitionVotes — not under boards/{version}.
    // Clients create status=='open' petitions and ±1/0 votes; status edits are console-only.
    function validPetitionId(id) {
      return id.matches("[A-Za-z0-9_-]{6,64}");
    }

    function validVoterId(id) {
      return id.matches("[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}");
    }

    function validPetition(d) {
      return d.category in ['bugs', 'balance', 'ideas']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 1500
        && validName(d.name)
        && d.gameVersion is string && d.gameVersion.matches("\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-[0-9A-Za-z.]{1,12})?")
        && d.source in ['live', 'dev']
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if validPetitionId(petitionId)
        && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'name', 'createdAt', 'gameVersion', 'status', 'source'])
        && request.resource.data.keys().hasAll(['category', 'title', 'body', 'name', 'createdAt', 'gameVersion', 'status', 'source'])
        && validPetition(request.resource.data);
      allow update, delete: if false;
    }

    match /petitionVotes/{voteId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['petitionId', 'voterId', 'value'])
        && request.resource.data.keys().hasAll(['petitionId', 'voterId', 'value'])
        && validPetitionId(request.resource.data.petitionId)
        && validVoterId(request.resource.data.voterId)
        && voteId == request.resource.data.petitionId + '_' + request.resource.data.voterId
        && request.resource.data.value in [1, -1]
        && exists(/databases/$(database)/documents/petitions/$(request.resource.data.petitionId));
      allow update: if request.resource.data.keys().hasOnly(['petitionId', 'voterId', 'value'])
        && request.resource.data.keys().hasAll(['petitionId', 'voterId', 'value'])
        && resource.data.petitionId == request.resource.data.petitionId
        && resource.data.voterId == request.resource.data.voterId
        && voteId == resource.data.petitionId + '_' + resource.data.voterId
        && request.resource.data.value in [1, -1, 0];
      allow delete: if false;
    }

    // Ranked 1v1 duels: create-only match log (id = runId). Ratings may be denormalized
    // on duelRatings; clients can also replay matches. Does not touch boards/*/highscores.
    function validDuelMatch(matchId, d) {
      return matchId.matches("[A-Za-z0-9_-]{6,64}")
        && d.winner is string && validName(d.winner)
        && d.loser is string && validName(d.loser)
        && d.winner != d.loser
        && d.winnerKills is int && d.loserKills is int
        && d.winnerKills >= 2 && d.winnerKills <= 1000000
        && d.loserKills >= 0 && d.loserKills < d.winnerKills
        && d.version is string && d.version.matches("\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-[0-9A-Za-z.]{1,12})?")
        && d.mode in ['p2p', 'dedicated']
        && d.timestamp == request.time;
    }

    match /duelMatches/{matchId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['winner', 'loser', 'winnerKills', 'loserKills', 'version', 'mode', 'timestamp'])
        && request.resource.data.keys().hasAll(['winner', 'loser', 'winnerKills', 'loserKills', 'version', 'mode', 'timestamp'])
        && validDuelMatch(matchId, request.resource.data);
      allow update, delete: if false;
    }

    function validDuelRating(d) {
      return validName(d.name)
        && d.rating is int && d.rating >= 100 && d.rating <= 4000
        && d.wins is int && d.wins >= 0 && d.wins <= 1000000
        && d.losses is int && d.losses >= 0 && d.losses <= 1000000
        && d.wins + d.losses >= 1
        && d.timestamp == request.time;
    }

    match /duelRatings/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'wins', 'losses', 'timestamp'])
        && request.resource.data.keys().hasAll(['name', 'rating', 'wins', 'losses', 'timestamp'])
        && validDuelRating(request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(['name', 'rating', 'wins', 'losses', 'timestamp'])
        && request.resource.data.keys().hasAll(['name', 'rating', 'wins', 'losses', 'timestamp'])
        && resource.data.name == request.resource.data.name
        && validDuelRating(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
